@startuml
!theme plain
autonumber

participant "Gateway\n(GatewayWorker)" as GW
participant "Engine\n(EngineWorker)" as ENG
queue "RabbitMQ" as MQ

== Service Initialization ==

GW -> GW: SetupRabbitMq()
ENG -> ENG: SetupRabbitMq()

== Service Ready Events ==

GW -> MQ: Publish ServiceReadyEvent\n("Gateway")
ENG -> MQ: Publish ServiceReadyEvent\n("Engine")

note over ENG
  ServiceReadyHandler (Engine)\n  holds a static HashSet — persists\n  across DI scope invocations
end note

MQ -> ENG: Deliver ServiceReadyEvent("Gateway")
ENG -> ENG: _readyServices.Add("Gateway")
MQ -> ENG: Deliver ServiceReadyEvent("Engine")
ENG -> ENG: _readyServices.Add("Engine")

== All Services Ready ==

ENG -> ENG: All required services ready?\n✓ Gateway\n✓ Engine
ENG -> MQ: Publish SystemReadyEvent

MQ -> GW: Deliver SystemReadyEvent
MQ -> ENG: Deliver SystemReadyEvent

== Unblock Execution ==

GW -> GW: MarkSystemReady()\nTaskCompletionSource.SetResult(true)
GW -> GW: NotifySystemReady()
ENG -> ENG: MarkSystemReady()\nTaskCompletionSource.SetResult(true)

note over GW, ENG
  WaitForSystemReadyAsync() unblocked\n  Phase 1 complete
end note

@enduml

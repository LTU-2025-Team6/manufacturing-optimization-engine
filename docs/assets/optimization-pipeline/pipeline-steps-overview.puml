@startuml
!theme plain
skinparam componentStyle rectangle
left to right direction

rectangle "WorkflowPipeline" {
  rectangle "1. Workflow\nMatching" as S1 #LightBlue
  rectangle "2. Provider\nMatching" as S2 #LightBlue
  rectangle "3. Estimation" as S3 #LightGreen
  rectangle "4. Optimization\n(OR-Tools)" as S4 #LightYellow
  rectangle "5. Strategy\nSelection" as S5 #LightCoral
  rectangle "6. Finalization" as S6 #LightBlue

  S1 -right-> S2
  S2 -right-> S3
  S3 -right-> S4
  S4 -right-> S5
  S5 -right-> S6
}

note right of S1
  Upgrade (7 steps)\nvs Refurbish (5 steps)\nbased on efficiency delta
end note

note right of S2
  Match providers to each\nprocess by capability\n& technical requirements
end note

note right of S3
  AsyncAwaiter: publish\nPropose → await Estimated\nper provider (parallel)
end note

note right of S4
  MIP solver (OR-Tools)\ngenerates 4 strategies:\nCost / Speed / Quality / Emissions
end note

note right of S5
  Publish AwaitingSelection,\nAsyncAwaiter blocks\nup to 10 min for\nSelectStrategyCommand
end note

note right of S6
  Set plan status Ready,\npublish final\nOptimizationPlanUpdated
end note

@enduml
